APP_PORT=5173
APP_TIMEZONE=America/Toronto
DB_NAME=calendar
# Base du serveur de développement (scripts/dev-db.sh create|copy), jamais celle de la production
DEV_DB_NAME=calendar_dev
DB_USER=calendar
DB_PASSWORD=calendar
DB_ROOT_PASSWORD=root
DB_PUBLIC_PORT=3307
# Mettre à true derrière HTTPS
COOKIE_SECURE=false

# --- Publication sur le web (Cloudflare Tunnel, voir scripts/web.sh) ---
# Adresse publique : un sous-domaine d'un domaine géré par votre compte Cloudflare
PUBLIC_HOSTNAME=disponibilites.example.com
# Nom du tunnel Cloudflare dédié à l'application
TUNNEL_NAME=disponibilites
# Port local du service de production (http://127.0.0.1:8090)
WEB_PORT=8090
# Ajouté par « scripts/web.sh publish » : « docker compose up -d » démarre aussi web + tunnel
# COMPOSE_PROFILES=public
# Utilisateur du conteneur « tunnel » : celui qui possède deploy/cloudflared/ (identifiants en mode 600).
# scripts/web.sh les remplit tout seul ; à indiquer si votre identifiant (id -u / id -g) n'est pas 1000.
# HOST_UID=1000
# HOST_GID=1000

# --- Pages « Confidentialité » et « Conditions d'utilisation » ---
# Responsable de la protection des renseignements personnels (loi québécoise : titre et coordonnées publiés)
LEGAL_CONTACT_NAME=
LEGAL_CONTACT_EMAIL=

# --- Courriels (liens de connexion), service Resend : https://resend.com ---
# Clé d'API ; sans elle, « Recevoir un lien par courriel » est désactivé
RESEND_API_KEY=
# Expéditeur, sur un domaine vérifié dans Resend (sinon onboarding@resend.dev, qui n'écrit qu'au titulaire du compte)
MAIL_FROM=Disponibilités <connexion@disponibilites.example.com>
